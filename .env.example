# Copy file này thành .env ở thư mục gốc repo rồi điền key. KHÔNG commit .env.
OPENAI_API_KEY=

# Vector store Day 6 (PostgreSQL + pgvector chạy bằng Docker trong repo Day 6, cổng 55433)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Nếu Windows chặn cổng 55433 (WinNAT): chạy container với docker-compose.override.yml (cổng 55533) và đổi URL thành 127.0.0.1:55533
# Index Day 6 được dùng (strategy B = paragraph chunks, cấu hình đã chốt ở Day 6)
DAY6_STRATEGY=B

# Embedding phải trùng với index Day 6
EMBEDDING_MODEL=text-embedding-3-small

# Model điều phối agent (có tool calling)
AGENT_MODEL=gpt-5.4-mini-2026-03-17
